  "sections": [
    {
      "heading": "What to establish first",
      "blocks": [
        {
          "type": "list",
          "items": [
            "Supplier identity and quotation date",
            "Currency",
            "Product or service description",
            "Quantity and minimum order requirements",
            "Unit and total pricing",
            "Payment terms",
            "Lead time and validity period"
          ]
        }
      ]
    },
    {
      "heading": "Do not fill gaps by assumption",
      "blocks": [
        {
          "type": "paragraph",
          "text": "If a commercial term is absent or ambiguous, the correct next step is clarification. Silence in a quotation should not be converted into a favourable assumption in the internal record."
        }
      ]
    }
  ]
